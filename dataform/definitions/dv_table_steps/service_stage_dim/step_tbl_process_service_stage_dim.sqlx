js {
  const { service_stage_source: source } = require("definitions/param/source/ehr_clinical_ref_data.js");
  const { target } = require("definitions/param/target/service_stage_dim.js");
  const { fn_calculateHash, fn_calculateConcat } = require("includes/functions.js");
  const glb_env = require("includes/glb_env.js");
}

config {
  type: "table",
  name: "step_tbl_process_service_stage_dim",
  schema: glb_env.datasets.staging,
  dependencies: ["step_tbl_read_service_stage_dim"],
  description: "Processes service stage records for loading into service_stage_dim",
  tags: ["service_stage", "dim"]
}

WITH
  cte_read_data AS (
    SELECT
      ref_code,
      ref_name,
      high_level_stage,
      care_setting,
      sla_threshold_mins
    FROM ${ref("step_tbl_read_service_stage_dim")}
  ),

  cte_transformed AS (
    SELECT
      ${fn_calculateHash(source.dk)} AS srv_stage_dk,
      ${fn_calculateConcat(source.bk)} AS srv_stage_bk,
      trim(ref_name) AS srv_name,
      trim(high_level_stage) AS high_lvl_stage,
      trim(care_setting) AS care_set,
      sla_threshold_mins AS sla_wait_threshold,
      CURRENT_TIMESTAMP() AS load_ts
    FROM cte_read_data
  )

SELECT
  srv_stage_dk,
  srv_stage_bk,
  ${fn_calculateHash(source.hash_diff)} AS hash_diff,
  srv_name,
  high_lvl_stage,
  care_set,
  sla_wait_threshold,
  load_ts
FROM cte_transformed