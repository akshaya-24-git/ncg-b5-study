js {
    const {
        source: source_config
    } = require("definitions/param/source/ehr_bed_occupancy.js");
    const {
        fn_calculateConcat,
        fn_calculateHash
    } = require("includes/functions.js");
}

config {
    type: "table",
    name: "step_tbl_process_bed_census_daily_fct",
    schema: dataform.projectConfig.vars.stagingDataset,
    dependencies: ["step_tbl_read_bed_census_daily_fct"],
    description: "Applies business logic to bed census daily fact data.",
    tags: ["bed", "fact", "census"]
}

WITH
    cte_read_data AS (
        SELECT
            occupancy_id,
            census_date,
            bed_id,
            bed_category,
            facility_code,
            department_code,
            patient_id,
            bed_status,
            patient_admit_date,
            patient_discharge_date
        FROM ${ref("step_tbl_read_bed_census_daily_fct")}
    ),

    cte_transformed AS (
        SELECT
            o.occupancy_id,
            o.census_date,
            b.bed_bk AS bed_fk,
            f.facility_bk AS facility_fk,
            dept.dept_bk AS department_fk,
            p.ptnt_bk AS patient_fk,
            CASE
                WHEN UPPER(CAST(o.bed_status AS STRING)) IN ('Y', 'YES', 'TRUE', '1', 'OCCUPIED', 'O') THEN 1
                ELSE 0
            END AS is_occupied,
            CASE
                WHEN UPPER(CAST(o.bed_status AS STRING)) IN ('VACANT', 'V', 'AVAILABLE', 'EMPTY', '2') THEN 1
                ELSE 0
            END AS is_vaccant,
            CASE
                WHEN UPPER(CAST(o.bed_status AS STRING)) IN ('MAINTENANCE', 'M', 'CLEANING', 'BLOCKED', 'OUT OF SERVICE', '3') THEN 1
                ELSE 0
            END AS is_maintained,
            CASE
                WHEN o.patient_admit_date = o.census_date THEN 1
                ELSE 0
            END AS is_admitted_today,
            CASE
                WHEN o.patient_discharge_date = o.census_date THEN 1
                ELSE 0
            END AS is_discharge_today,
            CURRENT_TIMESTAMP() AS load_ts
        FROM
            cte_read_data AS o
        LEFT JOIN
            ${ref("bed_dim")} AS b
            ON b.bed_bk = CONCAT('MTRXB5<>', CAST(o.bed_id AS STRING), '<>', CAST(o.bed_category AS STRING))
        LEFT JOIN
            ${ref("patient_dim")} AS p
            ON p.ptnt_bk = CONCAT('MTRXB5<>', CAST(o.patient_id AS STRING))
        LEFT JOIN
            ${ref("facility_dim")} AS f
            ON f.facility_bk = CONCAT('MTRXB5<>', CAST(o.facility_code AS STRING))
        LEFT JOIN
            ${ref("department_dim")} AS dept
            ON dept.dept_bk = CONCAT('MTRXB5<>', CAST(o.department_code AS STRING), '<>', CAST(o.facility_code AS STRING))
    ),

    cte_final AS (
        SELECT
            ${fn_calculateHash(source_config.dk)} AS bed_census_dk,
            ${fn_calculateConcat(source_config.bk)} AS bed_census_bk,
            bed_fk,
            facility_fk,
            department_fk,
            patient_fk,
            occupancy_id,
            census_date,
            is_occupied,
            is_vaccant,
            is_maintained,
            is_admitted_today,
            is_discharge_today,
            load_ts,
            TO_HEX(MD5(CONCAT(
                IFNULL(CAST(occupancy_id AS STRING), 'NULL_REPLACED'), '~',
                IFNULL(CAST(is_occupied AS STRING), 'NULL_REPLACED'), '~',
                IFNULL(CAST(is_vaccant AS STRING), 'NULL_REPLACED'), '~',
                IFNULL(CAST(is_maintained AS STRING), 'NULL_REPLACED'), '~',
                IFNULL(CAST(is_admitted_today AS STRING), 'NULL_REPLACED'), '~',
                IFNULL(CAST(is_discharge_today AS STRING), 'NULL_REPLACED')
            ))) AS hash_diff
        FROM
            cte_transformed
    )

SELECT
    bed_census_dk,
    bed_census_bk,
    bed_fk,
    facility_fk,
    department_fk,
    patient_fk,
    occupancy_id,
    census_date,
    is_occupied,
    is_vaccant,
    is_maintained,
    is_admitted_today,
    is_discharge_today,
    load_ts,
    hash_diff
FROM cte_final;
