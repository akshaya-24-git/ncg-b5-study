js {
  const { source: source_config } = require("definitions/param/source/ehr_ptnt_diagnosis.js");
  const { fn_calculateHash, fn_calculateConcat } = require("includes/functions.js");
}

config {
  type: "table",
  name: "step_tbl_process_patient_diagnosis_brg",
  schema: dataform.projectConfig.vars.stagingDataset,
  dependencies: ["step_tbl_read_patient_diagnosis_brg"],
  description: "Processes patient diagnosis rows into the bridge staging model with SCD2 metadata.",
  tags: ["patient", "diagnosis", "bridge", "scd2"]
}

WITH
  cte_raw_source AS (
    SELECT
      patient_id,
      icd10_code,
      diagnosis_type,
      onset_date,
      resolution_date,
      is_active,
      last_updated
    FROM
      ${ref("step_tbl_read_patient_diagnosis_brg")}
  ),

  cte_transformed AS (
    SELECT
      ${fn_calculateHash(source_config.dk)} AS bridge_dk,
      ${fn_calculateConcat(source_config.bk)} AS bridge_bk,
      patient_id AS patient_fk,
      icd10_code AS diagnosis_fk,
      diagnosis_type,
      onset_date,
      resolution_date,
      ${fn_calculateHash(source_config.hash_diff)} AS hash_diff,
      CAST(last_updated AS TIMESTAMP) AS valid_from_ts,
      CAST('9999-12-31 23:59:59' AS TIMESTAMP) AS valid_to_ts,
      CASE WHEN is_active THEN 'Y' ELSE 'N' END AS current_ind,
      CURRENT_TIMESTAMP() AS load_ts
    FROM
      cte_raw_source
  ),

  cte_final AS (
    SELECT
      bridge_dk,
      bridge_bk,
      patient_fk,
      diagnosis_fk,
      diagnosis_type,
      onset_date,
      resolution_date,
      hash_diff,
      valid_from_ts,
      valid_to_ts,
      current_ind,
      load_ts
    FROM
      cte_transformed
  )

SELECT
  *
FROM
  cte_final
