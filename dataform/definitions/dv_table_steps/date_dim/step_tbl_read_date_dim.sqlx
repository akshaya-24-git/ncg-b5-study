js {
  const glb_env = require("includes/glb_env.js");
  const { source } = require("definitions/param/source/date_ref.js");
}

config {
    type: "table",
    schema: glb_env.datasets.staging,
    name: "step_tbl_read_date_dim",
    description: "Reads the date reference source used to build the conformed calendar dimension.",
    tags: ["conformed", "date", "dim"]
}

WITH cte_date_reference AS (
    SELECT
        CAST(holiday_date AS DATE) AS holiday_date,
        CAST(event_type AS STRING) AS event_type
    FROM ${ref(source.source_table_reference_date)}
)

SELECT
    holiday_date,
    event_type
FROM cte_date_reference
