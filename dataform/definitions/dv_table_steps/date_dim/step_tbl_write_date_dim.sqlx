js {
    // ---- Import project-specific environment variables ----
    // We import the whole file module as glb_env to match your parameter reference
    const glb_env = require("includes/glb_env.js");

    // ---- Import parameters for the job, source, and target tables ----
    const { source } = require("definitions/param/source/date_ref.js");
    const { target } = require("definitions/param/target/date_dim.js");
    const { fn_FullLoad } = require("includes/functions.js");   
}


config {
    type: "operations",
    name: "step_tbl_write_date_dim",
    dependencies: ["step_tbl_process_date_dim"],
    description: "Loads processed data into the date_dim table.",
    tags: ["conformed", "date", "dim"]
}

-- Execute the loader function using the locally bound variables
${fn_FullLoad({
    source_ref: ref("step_tbl_process_date_dim"),
    target_name: target.target_table,
    // We pull the project ID cleanly through Dataform's native context block or your glb_env mapping
    project_id: dataform.projectConfig.defaultProject || "fy23-asc-addg-dataverse",
    tgt_dataset: glb_env.datasets.target,
    target_params: target
})}
