js {
    const { source: source_config } = require("definitions/param/source/date_ref.js");
    const glb_env = require("includes/glb_env.js");
    const { fn_calculateHash } = require("includes/functions.js");
}

config {
    type: "table",
    name: "step_tbl_process_date_dim",
    schema: glb_env.datasets.staging,
    dependencies: ["step_tbl_read_date_dim"],
    description: "Builds the conformed date dimension from a generated calendar grid and date reference enrichment.",
    bigquery: {
        clusterBy: ["date_dk"]
    },
    tags: ["conformed", "date", "dim"]
}

WITH
    cte_calendar_grid AS (
        SELECT calendar_date
        FROM UNNEST(GENERATE_DATE_ARRAY('2022-01-01', '2025-12-31')) AS calendar_date
    ),

    cte_calendar_attributes AS (
        SELECT
            calendar_date AS full_date,
            FORMAT_DATE('%A', calendar_date) AS day_of_week,
            EXTRACT(DAYOFWEEK FROM calendar_date) AS day_of_week_num,
            EXTRACT(WEEK FROM calendar_date) AS week_of_year,
            EXTRACT(MONTH FROM calendar_date) AS month_num,
            FORMAT_DATE('%B', calendar_date) AS month_name,
            EXTRACT(QUARTER FROM calendar_date) AS quarter_num,
            EXTRACT(YEAR FROM calendar_date) AS year_num,
            EXTRACT(YEAR FROM DATE_ADD(calendar_date, INTERVAL 9 MONTH)) AS fiscal_year,
            CASE
                WHEN EXTRACT(DAYOFWEEK FROM calendar_date) IN (1, 7) THEN TRUE
                ELSE FALSE
            END AS is_weekend
        FROM cte_calendar_grid
    ),

    cte_reference_input AS (
        SELECT
            CAST(holiday_date AS DATE) AS holiday_date,
            CAST(event_type AS STRING) AS event_type
        FROM ${ref("step_tbl_read_date_dim")}
    ),

    cte_final_transformed AS (
        SELECT
            ${fn_calculateHash(source_config.dk)} AS date_dk,
            base.full_date,
            base.day_of_week,
            base.day_of_week_num,
            base.week_of_year,
            base.month_num,
            base.month_name,
            base.quarter_num,
            base.year_num,
            base.fiscal_year,
            base.is_weekend,
            CASE
                WHEN ref.event_type = 'HOLIDAY' THEN TRUE
                ELSE FALSE
            END AS is_holiday,
            CASE
                WHEN ref.event_type = 'FESTIVAL' THEN TRUE
                ELSE FALSE
            END AS is_festival
        FROM cte_calendar_attributes AS base
        LEFT JOIN cte_reference_input AS ref
            ON base.full_date = ref.holiday_date
    )

SELECT *
FROM cte_final_transformed
